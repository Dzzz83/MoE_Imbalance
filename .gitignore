# ── Project docs — local-only knowledge base, NOT pushed to GitHub ──
# docs/ holds the project's context, results, literature and routing records.
# It is kept locally and deliberately excluded from the repository.
# Note: after untracking, these files remain in git history; removing them from
# history requires a rewrite (git filter-repo / BFG).
docs/

# ── Python virtual environment ──
.venv/

# ── Data (downloaded CIFAR-100 archive and extracted files) ──
/data/cifar-100-python/
/data/cifar-100-python.tar.gz

# ── Generated split indices ──
# Everything here stays local EXCEPT the canonical long-tailed training split.
# It is 87 KB, fully deterministic (IR=100, seed 42) and required before the
# first training step, so it must travel with the repo: a Kaggle clone without
# it dies with ProtocolError before epoch 1.
# Note: the parent directory is deliberately NOT excluded wholesale — git cannot
# re-include a file whose parent directory is excluded.
/data/processed/*
!/data/processed/lt_ir100_train_indices.npy

# ── Python bytecode ──
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# ── macOS ──
.DS_Store

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo
*~
